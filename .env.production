# Production Environment Variables
NODE_ENV=production

# API Configuration
API_BASE_URL=https://api-bemo.alpox.dev/api
API_TIMEOUT=15000

# App Configuration
APP_NAME=BEMO
APP_VERSION=1.0.0

# Debug Settings
DEBUG_MODE=false
LOG_LEVEL=error

# Google Maps API Key (Google Cloud Console에서 발급받아 설정)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE 