# Development Environment Variables
NODE_ENV=development

# API Configuration
API_BASE_URL=http://192.168.64.216:8000/api
API_TIMEOUT=10000

# App Configuration
APP_NAME=BEMO Development
APP_VERSION=1.0.0-dev

# Debug Settings
DEBUG_MODE=true
LOG_LEVEL=debug

# Google Maps API Key (Google Cloud Console에서 발급받아 설정)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE 